# Copy to .env for local runs. On Dokploy, paste these into the
# compose service's "Environment" tab instead (never commit .env).

GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=change-me
GEOSERVER_WORKSPACE=gis

# Public hostname and URL GeoServer is served on (used for the CSRF
# whitelist and the URLs written into WMS/WFS GetCapabilities).
GEOSERVER_DOMAIN=gis.example.com
PROXY_BASE_URL=https://gis.example.com/geoserver

# Lock this down to your web app origins once they exist.
CORS_ALLOWED_ORIGINS=*

# JVM heap; keep Xmx well under the VPS RAM.
GEOSERVER_XMS=1g
GEOSERVER_XMX=2g

# Optional extra GeoServer extensions, comma-separated (e.g. vectortiles,wps).
GEOSERVER_EXTENSIONS=

POSTGRES_DB=gis
POSTGRES_USER=gis
POSTGRES_PASSWORD=change-me-too
